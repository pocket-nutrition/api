          "sourceSurface" : {
            "type" : [ "string", "null" ],
            "description" : "Which client surface this report came from",
            "example" : "community"
          }
        }
      },
      "ReferenceIntakeValue" : {
        "type" : "object",
        "description" : "One reference value: a nutrient, a population group, a value kind and its bounds",
        "properties" : {
          "nutrient" : {
            "type" : "string",
            "description" : "Nutrient name as EFSA publishes it",
            "example" : "Iron"
          },
          "nutrientKey" : {
            "type" : [ "string", "null" ],
            "description" : "The NutritionalProfileResponse field this value can be compared with, when the units are compatible (e.g. \"ironMg\"). Null when EFSA's unit or definition differs from the journal's (energy in MJ, niacin per MJ, vitamin A in retinol equivalents, added and free sugars versus total sugars).",
            "example" : "ironMg"
          },
          "classification" : {
            "type" : "string",
            "description" : "EFSA grouping",
            "example" : "Minerals"
          },
          "population" : {
            "type" : "string",
            "description" : "Population group",
            "example" : "Adults"
          },
          "populationDescription" : {
            "type" : "string",
            "description" : "Population detail, e.g. a pregnancy trimester or menopause status",
            "example" : "Premenopausal women"
          },
          "ageFrom" : {
            "type" : [ "number", "null" ],
            "format" : "double",
            "description" : "Lower bound of the age band"
          },
          "ageTo" : {
            "type" : [ "number", "null" ],
            "format" : "double",
            "description" : "Upper bound of the age band (999 = no upper bound)"
          },
          "ageUnit" : {
            "type" : [ "string", "null" ],
            "description" : "Unit of the age bounds",
            "enum" : [ "y", "mo" ]
          },
          "ageLabel" : {
            "type" : [ "string", "null" ],
            "description" : "Age band as EFSA labels it, verbatim",
            "example" : "≥ 18 years"
          },
          "pal" : {
            "type" : [ "number", "null" ],
            "format" : "double",
            "description" : "Physical activity level, for energy values only",
            "example" : 1.6
          },
          "sex" : {
            "type" : [ "string", "null" ],
            "description" : "Sex label as EFSA writes it, verbatim",
            "example" : "Male/Female"
          },
          "valueKind" : {
            "type" : "string",
            "description" : "ai = adequate intake, ar = average requirement, ar_kcal = the same energy requirement in kcal, pri = population reference intake, ri = reference intake range (% of energy), ul = tolerable upper intake level, ssi = safe and sufficient intake",
            "enum" : [ "ssi", "ai", "ar", "ar_kcal", "pri", "ri", "ul" ]
          },
          "raw" : {
            "type" : "string",
            "description" : "The value as EFSA writes it, verbatim (\"11\", \"(+) 70\", \"45–60\", \"ND\")",
            "example" : "11"
          },
          "valueMin" : {
            "type" : [ "number", "null" ],
            "format" : "double",
            "description" : "Lower bound, equal to valueMax for a single value; null when EFSA gives no number (ND, NA.)"
          },
          "valueMax" : {
            "type" : [ "number", "null" ],
            "format" : "double",
            "description" : "Upper bound; null when EFSA gives no number"
          },
          "unit" : {
            "type" : [ "string", "null" ],
            "description" : "Unit as EFSA writes it",
            "example" : "mg/day"
          },
          "sourceLink" : {
            "type" : [ "string", "null" ],
            "description" : "The EFSA scientific opinion the value comes from"
          },
          "note" : {
            "type" : [ "string", "null" ],
            "description" : "EFSA's explanatory note for this value"
          },
          "isMale" : {
            "type" : "boolean"
          },
          "isFemale" : {
            "type" : "boolean"
          },
          "isIncrement" : {
            "type" : "boolean"
          }
        }
      },
      "ReferenceIntakesResponse" : {
        "type" : "object",
