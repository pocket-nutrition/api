          },
          "canEatRaw" : {
            "type" : [ "boolean", "null" ],
            "description" : "Whether this ingredient can be eaten raw; null when unknown"
          },
          "canEatCooked" : {
            "type" : [ "boolean", "null" ],
            "description" : "Whether this ingredient can be cooked; null when unknown"
          },
