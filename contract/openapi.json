              "$ref" : "#/components/schemas/FeedbackCorrection"
            }
          },
          "comment" : {
            "type" : [ "string", "null" ]
          },
          "cookingMethod" : {
            "type" : [ "string", "null" ]
          },
          "measuredState" : {
            "type" : [ "string", "null" ]
          },
          "sourceSurface" : {
            "type" : "string",
            "description" : "Which client surface this report came from",
