{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Pocket Nutrition API",
    "description" : "Predicts cooked nutritional profiles from raw ingredients and cooking methods. Results are served from an Elasticsearch cache on repeat queries; cache misses are forwarded to the pocket-nutrition-ml prediction service.",
    "version" : "2.5.1"
  },
  "servers" : [ {
    "url" : "http://localhost",
    "description" : "Generated server url"
  } ],
  "tags" : [ {
    "name" : "Nutrition",
    "description" : "Nutritional profile prediction"
  }, {
    "name" : "Reference intakes",
    "description" : "Dietary reference values the clients compute daily targets from"
  }, {
    "name" : "Ingredients",
    "description" : "Ingredient search and barcode lookup"
  }, {
    "name" : "Relationship votes",
    "description" : "Anonymous confidence votes on curated cooking relationships"
  }, {
    "name" : "Mapping votes",
    "description" : "Anonymous confidence votes on ingredient↔source mapping associations"
  }, {
    "name" : "Feedback",
    "description" : "Anonymous user feedback on ingredient data quality"
  } ],
  "paths" : {
    "/relationships/vote" : {
      "post" : {
        "tags" : [ "Relationship votes" ],
        "summary" : "Upvote or downvote confidence in one curated cooking relationship",
        "operationId" : "vote",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RelationshipVoteRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Vote recorded",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RelationshipVoteTallyResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Blank ingredientId/cookingMethod, invalid direction, or unknown sourceSurface",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RelationshipVoteTallyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/nutrition" : {
      "post" : {
        "tags" : [ "Nutrition" ],
        "summary" : "Predict nutritional profiles for a list of food items",
        "operationId" : "getNutrition",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "type" : "array",
                "items" : {
                  "$ref" : "#/components/schemas/FoodItemRequest"
                }
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "Nutritional profiles computed",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/NutritionalProfileResponse"
                  }
                }
              }
            }
          },
          "400" : {
            "description" : "Empty list or unsupported unit",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/NutritionalProfileResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/mappings/vote" : {
      "post" : {
        "tags" : [ "Mapping votes" ],
        "summary" : "Upvote or downvote confidence in one ingredient↔source mapping association",
        "operationId" : "vote_1",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/MappingVoteRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Vote recorded",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MappingVoteTallyResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Unknown source, blank sourceId/cookingMethod, invalid direction, or unknown sourceSurface",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MappingVoteTallyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/feedback" : {
      "get" : {
        "tags" : [ "Feedback" ],
        "summary" : "List public feedback reports for one ingredient, newest first",
        "operationId" : "list",
        "parameters" : [ {
          "name" : "ingredientId",
          "in" : "query",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "offset",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 0
          }
        }, {
          "name" : "limit",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 5
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Reports for the ingredient, with moderation-only fields stripped",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FeedbackReportsResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Blank ingredientId, or offset/limit out of range",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FeedbackReportsResponse"
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "Feedback" ],
        "summary" : "Submit structured corrections and/or a comment about an ingredient",
        "operationId" : "submit",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/FeedbackRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Feedback received",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "object",
                  "additionalProperties" : {
                    "type" : "string"
                  }
                }
              }
            }
          },
          "400" : {
            "description" : "No corrections and no comment, unknown category/code, or oversized input",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "object",
                  "additionalProperties" : {
                    "type" : "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/relationships/votes" : {
      "get" : {
        "tags" : [ "Relationship votes" ],
        "summary" : "Batch-fetch current vote tallies for a set of cooking relationships",
        "operationId" : "batchVotes",
        "parameters" : [ {
          "name" : "key",
          "in" : "query",
          "description" : "Repeated 'ingredientId:cookingMethod' keys",
          "required" : true,
          "schema" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "example" : "chicken_breast:grilled"
        } ],
        "responses" : {
          "200" : {
            "description" : "Tallies keyed by the requested 'ingredientId:cookingMethod' key, defaulting to {0,0} when untracked",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "object",
                  "additionalProperties" : {
                    "$ref" : "#/components/schemas/RelationshipVoteTallyResponse"
                  }
                }
              }
            }
          },
          "400" : {
            "description" : "A key is malformed",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "object",
                  "additionalProperties" : {
                    "$ref" : "#/components/schemas/RelationshipVoteTallyResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/reference-intakes" : {
      "get" : {
        "tags" : [ "Reference intakes" ],
        "summary" : "The full EFSA dietary reference table",
        "description" : "Takes no parameter on purpose: the profile (age, sex, weight, pregnancy) never leaves the device. The client caches this response and selects the rows for its user locally.",
        "operationId" : "referenceIntakes",
        "responses" : {
          "200" : {
            "description" : "Every reference value, with its source",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ReferenceIntakesResponse"
                }
              }
            }
          },
          "503" : {
            "description" : "The reference table has not been loaded on this server yet",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ReferenceIntakesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/mappings/votes" : {
      "get" : {
        "tags" : [ "Mapping votes" ],
        "summary" : "Batch-fetch current vote tallies for a set of mapping associations",
        "operationId" : "batchVotes_1",
        "parameters" : [ {
          "name" : "key",
          "in" : "query",
          "description" : "Repeated 'source:sourceId:cookingMethod' keys",
          "required" : true,
          "schema" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "example" : "ciqual:9102:raw"
        } ],
        "responses" : {
          "200" : {
            "description" : "Tallies keyed by the requested 'source:sourceId:cookingMethod' key, defaulting to {0,0} when untracked",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "object",
                  "additionalProperties" : {
                    "$ref" : "#/components/schemas/MappingVoteTallyResponse"
                  }
                }
              }
            }
          },
          "400" : {
            "description" : "A key is malformed or its source is unknown",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "object",
                  "additionalProperties" : {
                    "$ref" : "#/components/schemas/MappingVoteTallyResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ingredients/{id}" : {
      "get" : {
        "tags" : [ "Ingredients" ],
        "summary" : "Get full reference detail for one ingredient",
        "description" : "Returns the knowledge-base detail behind one ingredient or product — name, food group, reference weight, serving units, and reference nutrition per 100 g. Used to show current known values alongside a correction form (e.g. the feedback dialog).",
        "operationId" : "detail",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "description" : "Ingredient id, as returned by /ingredients/search",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Ingredient detail",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/IngredientDetailResponse"
                }
              }
            }
          },
          "404" : {
            "description" : "Unknown ingredient id",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/IngredientDetailResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ingredients/search" : {
      "get" : {
        "tags" : [ "Ingredients" ],
        "summary" : "Search ingredients as you type",
        "description" : "Returns matching suggestions. When quantity + cooking_method are provided, each suggestion also includes its nutritional profile (cache or ML prediction).",
        "operationId" : "search",
        "parameters" : [ {
          "name" : "q",
          "in" : "query",
          "description" : "Search query",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "lang",
          "in" : "query",
          "description" : "Preferred language code (fr, en)",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "limit",
          "in" : "query",
          "description" : "Max results to return (1–50, default 10)",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 10
          }
        }, {
          "name" : "quantity",
          "in" : "query",
          "description" : "Quantity for nutritional enrichment — requires cooking_method",
          "required" : false,
          "schema" : {
            "type" : "number",
            "format" : "double"
          }
        }, {
          "name" : "unit",
          "in" : "query",
          "description" : "Unit of quantity ('g' or 'ml', default 'g')",
          "required" : false,
          "schema" : {
            "type" : "string",
            "default" : "g"
          }
        }, {
          "name" : "cooking_method",
          "in" : "query",
          "description" : "Cooking method (required when quantity is set)",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "measured_state",
          "in" : "query",
          "description" : "Whether quantity is before or after cooking",
          "required" : false,
          "schema" : {
            "type" : "string",
            "default" : "raw"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Matching ingredient suggestions",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/IngredientSuggestionWithNutrition"
                  }
                }
              }
            }
          },
          "400" : {
            "description" : "Blank query",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/IngredientSuggestionWithNutrition"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ingredients/barcode/{ean13}" : {
      "get" : {
        "tags" : [ "Ingredients" ],
        "summary" : "Look up a product by EAN-13 barcode",
        "operationId" : "barcode",
        "parameters" : [ {
          "name" : "ean13",
          "in" : "path",
          "description" : "EAN-13 barcode",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "lang",
          "in" : "query",
          "description" : "Preferred language code (fr, en)",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Nutritional profile (per 100 g) for the scanned product",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/IngredientSuggestionWithNutrition"
                }
              }
            }
          },
          "404" : {
            "description" : "Barcode not found in OpenFoodFacts catalogue",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/IngredientSuggestionWithNutrition"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "RelationshipVoteRequest" : {
        "type" : "object",
        "description" : "An anonymous confidence vote on one curated cooking relationship",
        "properties" : {
          "ingredientId" : {
            "type" : "string",
            "description" : "Canonical ingredient id",
            "example" : "chicken_breast"
          },
          "cookingMethod" : {
            "type" : "string",
            "description" : "Cooking method the relationship applies to",
            "example" : "grilled"
          },
          "direction" : {
            "type" : "string",
            "description" : "Vote direction",
            "example" : "up"
          },
          "sourceSurface" : {
            "type" : [ "string", "null" ],
            "description" : "Which client surface this vote came from",
            "example" : "community"
          }
        }
      },
      "RelationshipVoteTallyResponse" : {
        "type" : "object",
        "description" : "Current confidence tally for one cooking relationship",
        "properties" : {
          "upvotes" : {
            "type" : "integer",
            "format" : "int32"
          },
          "downvotes" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "FoodItemRequest" : {
        "type" : "object",
        "description" : "A food item to include in the nutritional prediction",
        "properties" : {
          "name" : {
            "type" : [ "string", "null" ],
            "description" : "Ingredient name (free text); optional when ingredientId is provided",
            "example" : "chicken breast"
          },
          "quantity" : {
            "type" : "number",
            "format" : "double",
            "description" : "Measured quantity",
            "example" : 150.0
          },
          "unit" : {
            "type" : "string",
            "description" : "Unit of measure",
            "enum" : [ "g", "ml", "item" ],
            "example" : "g"
          },
          "cookingMethod" : {
            "type" : "string",
            "description" : "Cooking method applied to the ingredient. Ignored when the resolved ingredient is an Open Food Facts branded product — the response is always the product's own values with cookingMethod=\"raw\" and source=\"off_direct\".",
            "enum" : [ "raw", "boiled", "steamed", "grilled", "roasted", "fried", "cooked" ],
            "example" : "grilled"
          },
          "measuredState" : {
            "type" : "string",
            "description" : "Whether the quantity was measured before or after cooking",
            "enum" : [ "raw", "cooked" ],
            "example" : "raw"
          },
          "ingredientId" : {
            "type" : [ "string", "null" ],
            "description" : "Pre-resolved canonical ingredient slug from /ingredients/search; bypasses name resolution when provided",
            "example" : "poulet_filet"
          }
        }
      },
      "NutritionalProfileResponse" : {
        "type" : "object",
        "description" : "Predicted nutritional profile for one food item (values per portion)",
        "properties" : {
          "name" : {
            "type" : "string"
          },
          "quantity" : {
            "type" : "number",
            "format" : "double",
            "description" : "Measured quantity"
          },
          "unit" : {
            "type" : "string",
            "description" : "Unit of measure",
            "enum" : [ "g" ]
          },
          "cookingMethod" : {
            "type" : "string",
            "description" : "Cooking method the values reflect. Always \"raw\" when source=\"off_direct\" (the client-requested cooking method is ignored for Open Food Facts branded products)."
          },
          "measuredState" : {
            "type" : "string",
            "description" : "Whether the quantity was measured before or after cooking",
            "enum" : [ "raw", "cooked" ]
          },
          "energyKcal" : {
            "type" : "number",
            "format" : "double",
            "description" : "Energy (kcal)"
          },
          "proteinG" : {
            "type" : "number",
            "format" : "double",
            "description" : "Protein (g)"
          },
          "fatG" : {
            "type" : "number",
            "format" : "double",
            "description" : "Total fat (g)"
          },
          "carbohydratesG" : {
            "type" : "number",
            "format" : "double",
            "description" : "Carbohydrates (g)"
          },
          "fiberG" : {
            "type" : [ "number", "null" ],
            "format" : "double",
            "description" : "Dietary fibre (g)"
          },
          "waterG" : {
            "type" : [ "number", "null" ],
            "format" : "double",
            "description" : "Water (g)"
          },
          "sugarsG" : {
            "type" : [ "number", "null" ],
            "format" : "double",
            "description" : "Sugars (g)"
          },
          "calciumMg" : {
            "type" : [ "number", "null" ],
            "format" : "double",
            "description" : "Calcium (mg)"
          },
          "ironMg" : {
            "type" : [ "number", "null" ],
            "format" : "double",
            "description" : "Iron (mg)"
          },
          "magnesiumMg" : {
            "type" : [ "number", "null" ],
            "format" : "double",
            "description" : "Magnesium (mg)"
          },
          "sodiumMg" : {
            "type" : [ "number", "null" ],
            "format" : "double",
            "description" : "Sodium (mg)"
          },
          "vitaminCMg" : {
            "type" : [ "number", "null" ],
            "format" : "double",
            "description" : "Vitamin C (mg)"
          },
          "saturatedFatG" : {
            "type" : [ "number", "null" ],
            "format" : "double",
            "description" : "Saturated fat (g)"
          },
          "monounsaturatedFatG" : {
            "type" : [ "number", "null" ],
            "format" : "double",
            "description" : "Monounsaturated fat (g)"
          },
          "polyunsaturatedFatG" : {
            "type" : [ "number", "null" ],
            "format" : "double",
            "description" : "Polyunsaturated fat (g)"
          },
          "cholesterolMg" : {
            "type" : [ "number", "null" ],
            "format" : "double",
            "description" : "Cholesterol (mg)"
          },
          "potassiumMg" : {
            "type" : [ "number", "null" ],
            "format" : "double",
            "description" : "Potassium (mg)"
          },
          "phosphorusMg" : {
            "type" : [ "number", "null" ],
            "format" : "double",
            "description" : "Phosphorus (mg)"
          },
          "zincMg" : {
            "type" : [ "number", "null" ],
            "format" : "double",
            "description" : "Zinc (mg)"
          },
          "vitaminAUg" : {
            "type" : [ "number", "null" ],
            "format" : "double",
            "description" : "Vitamin A (µg)"
          },
          "vitaminDUg" : {
            "type" : [ "number", "null" ],
            "format" : "double",
            "description" : "Vitamin D (µg)"
          },
          "vitaminB6Mg" : {
            "type" : [ "number", "null" ],
            "format" : "double",
            "description" : "Vitamin B6 (mg)"
          },
          "vitaminB12Ug" : {
            "type" : [ "number", "null" ],
            "format" : "double",
            "description" : "Vitamin B12 (µg)"
          },
          "niacinMg" : {
            "type" : [ "number", "null" ],
            "format" : "double",
            "description" : "Niacin / Vitamin B3 (mg)"
          },
          "confidence" : {
            "type" : "number",
            "format" : "double",
            "description" : "Prediction confidence score (0.0–1.0)",
            "example" : 0.87
          },
          "source" : {
            "type" : "string",
            "description" : "Origin of this result",
            "enum" : [ "cache", "ml", "off_direct", "unavailable" ]
          },
          "available" : {
            "type" : "boolean",
            "description" : "False when no nutritional data could be found for this item"
          }
        }
      },
      "MappingVoteRequest" : {
        "type" : "object",
        "description" : "An anonymous confidence vote on one ingredient↔source mapping association",
        "properties" : {
          "source" : {
            "type" : "string",
            "description" : "Source database",
            "example" : "ciqual"
          },
          "sourceId" : {
            "type" : "string",
            "description" : "The source's own identifier for the item",
            "example" : "9102"
          },
          "cookingMethod" : {
            "type" : "string",
            "description" : "Cooking method / preparation state the mapping applies to",
            "example" : "raw"
          },
          "direction" : {
            "type" : "string",
            "description" : "Vote direction",
            "example" : "up"
          },
          "sourceSurface" : {
            "type" : [ "string", "null" ],
            "description" : "Which client surface this vote came from",
            "example" : "community"
          }
        }
      },
      "MappingVoteTallyResponse" : {
        "type" : "object",
        "description" : "Current confidence tally for one mapping association",
        "properties" : {
          "upvotes" : {
            "type" : "integer",
