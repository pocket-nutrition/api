# Pocket Nutrition API — environment configuration
# Copy this file to .env (or export these as real environment variables / k8s Secret+ConfigMap
# entries) and fill in your own values.
# cp .env.example .env
#
# No hardcoded secrets were found in this codebase — every value below is already read from an
# environment variable in application.properties with a local-dev-only default. This file exists
# to document every configurable/override-able setting in one place.

# === Elasticsearch (nutrition cache + ingredient search) ===
SPRING_ELASTICSEARCH_URIS=http://localhost:9200

# === ML prediction service (pocket-nutrition-ml) ===
ML_SERVICE_URL=http://localhost:8000

# === Nutrition cache toggle ===
# Set to false to bypass Elasticsearch cache reads/writes entirely (NoOpCacheService).
NUTRITION_CACHE_ENABLED=true

# === PostgreSQL (ingredients / ingredient_variants catalogue, feedback_report table) ===
DATASOURCE_URL=jdbc:postgresql://localhost:5432/pocket_nutrition
DATASOURCE_USERNAME=pocket_nutrition
# REQUIRED — generate your own, do not reuse this placeholder
DATASOURCE_PASSWORD=change-me-to-a-random-string

# === Flyway (manages only the feedback_report table) ===
FLYWAY_ENABLED=true

# === Feedback endpoint (POST /feedback) ===
# Optional salt used to hash reporter IPs before storage. Empty by default (no IP stored).
# REQUIRED if you want IP hashing enabled — generate your own random string.
FEEDBACK_IP_HASH_SALT=

# === Published OpenAPI contract version ===
# Must match EXPECTED_CONTRACT_VERSION in
# src/test/kotlin/org/pocketnutrition/api/contract/OpenApiSnapshotTest.kt
PN_CONTRACT_VERSION=1.3.0
